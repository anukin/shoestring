<Layouts.app flash={@flash} current_scope={@current_scope}>
  <%= if @goal_error do %>
    <div class="max-w-4xl mx-auto p-6">
      <div
        id="cobbler-goal-error"
        role="alert"
        class="rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800"
      >
        {@goal_error}
      </div>
    </div>
  <% else %>
    <div class="max-w-6xl mx-auto space-y-8 p-6">
      <%!-- Header & lifecycle status --%>
      <div
        id="cobbler-goal-header"
        class="rounded-lg border border-zinc-200 bg-white p-6 shadow-sm"
      >
        <div class="flex flex-wrap items-center justify-between gap-4">
          <div>
            <p class="text-sm font-semibold uppercase tracking-[0.2em] text-zinc-500">
              Cobbler Goal
            </p>
            <h1 class="mt-2 text-2xl font-bold text-zinc-900">{@goal.title}</h1>
            <p class="text-xs text-zinc-500 font-mono mt-1">ID: {@goal.id}</p>
          </div>
          <div class="flex items-center gap-3">
            <span
              id="cobbler-goal-status"
              data-status={@lifecycle_presentation.status}
              class={[
                "inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full font-medium text-sm",
                @lifecycle_presentation.badge_class
              ]}
            >
              <.icon name={@lifecycle_presentation.icon} class="w-3.5 h-3.5" />
              {@lifecycle_presentation.label}
            </span>
            <button
              phx-click="refresh"
              id="cobbler-goal-refresh"
              class="rounded-md bg-zinc-900 px-3 py-1.5 text-xs font-semibold text-white hover:bg-zinc-700"
            >
              Refresh
            </button>
          </div>
        </div>
        <p class="mt-3 text-sm text-zinc-600">{@lifecycle_presentation.detail}</p>
      </div>

      <%!-- Degraded warnings --%>
      <%= if @warnings != [] do %>
        <div
          id="cobbler-warnings"
          role="alert"
          class="rounded-lg border border-amber-300 bg-amber-50 p-4 space-y-2"
        >
          <p class="text-sm font-semibold text-amber-900 flex items-center gap-1.5">
            <.icon name="hero-exclamation-triangle" class="w-4 h-4" /> Degraded state
          </p>
          <ul class="list-disc pl-5 text-sm text-amber-800">
            <%= for warning <- @warnings do %>
              <li id={"cobbler-warning-#{warning.id}"}>{warning.text}</li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <%= if not @rebuild.consistent? do %>
        <div
          id="cobbler-rebuild-warning"
          role="alert"
          class="rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800"
        >
          Command store does not match canonical events. Refresh re-reads; no state was changed by this page.
        </div>
      <% end %>

      <%!-- Admission decision --%>
      <div
        id="cobbler-admission"
        class="rounded-lg border border-zinc-200 bg-white p-6 shadow-sm space-y-4"
      >
        <h3 class="text-sm font-semibold uppercase tracking-wider text-zinc-800 flex items-center gap-1.5">
          <.icon name="hero-scale" class="w-4 h-4 text-zinc-500" /> Admission Decision
        </h3>
        <%= if @latest_decision do %>
          <div class="flex items-center gap-2">
            <span
              id="cobbler-decision-result"
              data-status={@latest_decision.presentation.status}
              class={[
                "inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full font-medium text-sm",
                @latest_decision.presentation.badge_class
              ]}
            >
              <.icon name={@latest_decision.presentation.icon} class="w-3.5 h-3.5" />
              {@latest_decision.presentation.label}
            </span>
            <span class="text-xs text-zinc-500">sequence {@latest_decision.sequence}</span>
          </div>
          <dl class="grid grid-cols-1 gap-x-4 gap-y-2 text-sm sm:grid-cols-2">
            <dt class="text-zinc-500">Reason code</dt>
            <dd id="cobbler-decision-reason" class="font-medium text-zinc-900">
              {@latest_decision.reason_code || "not recorded"}
            </dd>
            <dt class="text-zinc-500">Explanation</dt>
            <dd class="font-medium text-zinc-900">{@latest_decision.explanation}</dd>
            <dt class="text-zinc-500">Proposed reserves</dt>
            <dd id="cobbler-decision-reserves" class="font-mono text-xs text-zinc-900">
              {Jason.encode!(@latest_decision.reserves)}
            </dd>
            <dt class="text-zinc-500">Capacity evidence</dt>
            <dd id="cobbler-decision-observation" class="font-mono text-xs text-zinc-900">
              {Jason.encode!(@latest_decision.observation)}
            </dd>
            <%= if @latest_decision.defer_until do %>
              <dt class="text-zinc-500">Deferred until</dt>
              <dd id="cobbler-decision-defer-until" class="font-medium text-zinc-900">
                <time datetime={to_string(@latest_decision.defer_until)}>
                  {to_string(@latest_decision.defer_until)}
                </time>
              </dd>
            <% end %>
          </dl>
        <% else %>
          <p id="cobbler-decision-empty" class="text-sm text-zinc-500 italic">
            No admission decision has been recorded for this goal.
          </p>
        <% end %>
      </div>

      <%!-- Execution lease --%>
      <%= if @lease do %>
        <div
          id="cobbler-lease"
          class="rounded-lg border border-zinc-200 bg-white p-6 shadow-sm space-y-4"
        >
          <h3 class="text-sm font-semibold uppercase tracking-wider text-zinc-800 flex items-center gap-1.5">
            <.icon name="hero-key" class="w-4 h-4 text-zinc-500" /> Execution Lease
          </h3>
          <div class="flex flex-wrap items-center gap-2">
            <span
              id="cobbler-lease-status"
              data-status={@lease.status_presentation.status}
              class={[
                "inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full font-medium text-sm",
                @lease.status_presentation.badge_class
              ]}
            >
              <.icon name={@lease.status_presentation.icon} class="w-3.5 h-3.5" />
              {@lease.status_presentation.label}
            </span>
            <span
              id="cobbler-lease-renewal"
              data-status={@lease.renewal_presentation.status}
              class={[
                "inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full font-medium text-sm",
                @lease.renewal_presentation.badge_class
              ]}
            >
              <.icon name={@lease.renewal_presentation.icon} class="w-3.5 h-3.5" />
              {@lease.renewal_presentation.label}
            </span>
          </div>
          <dl class="grid grid-cols-2 gap-x-4 gap-y-2 text-sm sm:grid-cols-4">
            <dt class="text-zinc-500">Response budget</dt>
            <dd class="font-medium text-zinc-900">{@lease.response_budget}</dd>
            <dt class="text-zinc-500">Tool budget</dt>
            <dd class="font-medium text-zinc-900">{@lease.tool_budget}</dd>
            <dt class="text-zinc-500">Response reserve</dt>
            <dd class="font-medium text-zinc-900">{@lease.response_reserve}</dd>
            <dt class="text-zinc-500">Tool reserve</dt>
            <dd class="font-medium text-zinc-900">{@lease.tool_reserve}</dd>
            <dt class="text-zinc-500">Checkpoint cadence</dt>
            <dd class="font-medium text-zinc-900">{@lease.checkpoint_cadence}</dd>
            <dt class="text-zinc-500">Deadline</dt>
            <dd class="font-medium text-zinc-900">
              <time datetime={DateTime.to_iso8601(@lease.deadline)}>
                {DateTime.to_iso8601(@lease.deadline)}
              </time>
            </dd>
          </dl>
        </div>
      <% else %>
        <div
          id="cobbler-lease-empty"
          class="rounded-lg border border-dashed border-zinc-300 bg-white p-6"
        >
          <h3 class="text-sm font-semibold uppercase tracking-wider text-zinc-800 flex items-center gap-1.5">
            <.icon name="hero-key" class="w-4 h-4 text-zinc-500" /> Execution Lease
          </h3>
          <p class="mt-2 text-sm text-zinc-500 italic">
            No execution lease has been recorded for this goal. Lease rows appear once lease producers land.
          </p>
        </div>
      <% end %>

      <%!-- Checkpoint --%>
      <%= if @checkpoint do %>
        <div
          id="cobbler-checkpoint"
          class="rounded-lg border border-zinc-200 bg-white p-6 shadow-sm space-y-4"
        >
          <h3 class="text-sm font-semibold uppercase tracking-wider text-zinc-800 flex items-center gap-1.5">
            <.icon name="hero-document-check" class="w-4 h-4 text-zinc-500" /> Checkpoint
          </h3>
          <dl class="grid grid-cols-1 gap-x-4 gap-y-2 text-sm sm:grid-cols-2">
            <dt class="text-zinc-500">Next action</dt>
            <dd class="font-medium text-zinc-900">{@checkpoint.next_action}</dd>
            <dt class="text-zinc-500">Stop reason</dt>
            <dd class="font-medium text-zinc-900">{@checkpoint.stop_reason}</dd>
          </dl>
          <pre
            id="cobbler-checkpoint-contents"
            class="rounded-md bg-zinc-50 p-4 text-xs font-mono text-zinc-700 overflow-auto whitespace-pre-wrap border border-zinc-100 max-h-72"
          >{@checkpoint.contents_text}</pre>
        </div>
      <% else %>
        <div
          id="cobbler-checkpoint-empty"
          class="rounded-lg border border-dashed border-zinc-300 bg-white p-6"
        >
          <h3 class="text-sm font-semibold uppercase tracking-wider text-zinc-800 flex items-center gap-1.5">
            <.icon name="hero-document-check" class="w-4 h-4 text-zinc-500" /> Checkpoint
          </h3>
          <p class="mt-2 text-sm text-zinc-500 italic">
            No checkpoint has been recorded for this goal. Checkpoint rows appear once checkpoint producers land.
          </p>
        </div>
      <% end %>

      <%!-- Task claim --%>
      <%= if @claim_mine? do %>
        <div
          id="cobbler-claim"
          class="rounded-lg border border-zinc-200 bg-white p-6 shadow-sm space-y-4"
        >
          <h3 class="text-sm font-semibold uppercase tracking-wider text-zinc-800 flex items-center gap-1.5">
            <.icon name="hero-lock-closed" class="w-4 h-4 text-zinc-500" /> Active Task Claim
          </h3>
          <dl class="grid grid-cols-1 gap-x-4 gap-y-2 text-sm sm:grid-cols-2">
            <dt class="text-zinc-500">Intent</dt>
            <dd class="font-medium text-zinc-900">{@claim.intent}</dd>
            <dt class="text-zinc-500">Provider</dt>
            <dd class="font-medium text-zinc-900">{@claim.provider_id}</dd>
            <dt class="text-zinc-500">Command</dt>
            <dd class="font-mono text-xs text-zinc-900">{@claim.command_id}</dd>
            <dt class="text-zinc-500">Scope</dt>
            <dd class="font-medium text-zinc-900">{@claim.scope}</dd>
          </dl>
        </div>
      <% else %>
        <div
          id="cobbler-claim-empty"
          class="rounded-lg border border-dashed border-zinc-300 bg-white p-6"
        >
          <h3 class="text-sm font-semibold uppercase tracking-wider text-zinc-800 flex items-center gap-1.5">
            <.icon name="hero-lock-open" class="w-4 h-4 text-zinc-500" /> Active Task Claim
          </h3>
          <p class="mt-2 text-sm text-zinc-500 italic">
            This goal holds no active task claim.
          </p>
        </div>
      <% end %>

      <%!-- Handoff (read-only; a handoff targets a new run of the same goal) --%>
      <%= if @handoffs != [] do %>
        <div
          id="cobbler-handoff"
          class="rounded-lg border border-zinc-200 bg-white p-6 shadow-sm space-y-4"
        >
          <h3 class="text-sm font-semibold uppercase tracking-wider text-zinc-800 flex items-center gap-1.5">
            <.icon name="hero-arrow-right-circle" class="w-4 h-4 text-zinc-500" /> Handoff
          </h3>
          <%= for handoff <- @handoffs do %>
            <div
              id={"cobbler-handoff-#{handoff.sequence}"}
              class="rounded-md border border-zinc-200 p-4 space-y-2"
            >
              <dl class="grid grid-cols-1 gap-x-4 gap-y-2 text-sm sm:grid-cols-2">
                <dt class="text-zinc-500">Source provider</dt>
                <dd
                  id={"cobbler-handoff-source-#{handoff.sequence}"}
                  class="font-medium text-zinc-900"
                >
                  {handoff.source}
                </dd>
                <dt class="text-zinc-500">Receiver provider</dt>
                <dd
                  id={"cobbler-handoff-receiver-#{handoff.sequence}"}
                  class="font-medium text-zinc-900"
                >
                  {handoff.receiver}
                </dd>
                <dt class="text-zinc-500">Reason</dt>
                <dd class="font-medium text-zinc-900">{handoff.reason}</dd>
                <dt class="text-zinc-500">Next action</dt>
                <dd class="font-medium text-zinc-900">{handoff.next_action}</dd>
                <dt class="text-zinc-500">New run</dt>
                <dd class="font-mono text-xs text-zinc-900">{handoff.run_id}</dd>
                <dt class="text-zinc-500">Prior run</dt>
                <dd class="font-mono text-xs text-zinc-900">{handoff.prior_run_id}</dd>
                <dt class="text-zinc-500">Checkpoint</dt>
                <dd class="font-mono text-xs text-zinc-900">{handoff.checkpoint_id}</dd>
              </dl>
              <p class="text-xs text-zinc-500">
                Handoff targets a new run of this same goal; the goal rests in terminal handing_off.
                Sequence {handoff.sequence}.
              </p>
            </div>
          <% end %>
        </div>
      <% else %>
        <div
          id="cobbler-handoff-empty"
          class="rounded-lg border border-dashed border-zinc-300 bg-white p-6"
        >
          <h3 class="text-sm font-semibold uppercase tracking-wider text-zinc-800 flex items-center gap-1.5">
            <.icon name="hero-arrow-right-circle" class="w-4 h-4 text-zinc-500" /> Handoff
          </h3>
          <p class="mt-2 text-sm text-zinc-500 italic">
            No handoff has been recorded for this goal.
          </p>
        </div>
      <% end %>
      <%!-- Sleep honesty + manual wake/recheck --%>
      <div
        id="cobbler-sleep-card"
        class="rounded-lg border border-zinc-200 bg-white p-6 shadow-sm space-y-4"
      >
        <h3 class="text-sm font-semibold uppercase tracking-wider text-zinc-800 flex items-center gap-1.5">
          <.icon name="hero-moon" class="w-4 h-4 text-zinc-500" /> Deferred / Sleep State
        </h3>
        <%= if @lifecycle_state == :sleeping and @latest_decision && @latest_decision.defer_until do %>
          <p class="text-sm text-zinc-700">
            Deferred by admission decision until <time datetime={
              to_string(@latest_decision.defer_until)
            }>
              {to_string(@latest_decision.defer_until)}
            </time>.
            Waking happens only through a durable wake intent: an Oban wakeup-queue
            delivery for this goal's cobbler_wakeups row, which re-observes capacity
            before acting. No timer wakes this goal.
          </p>
        <% else %>
          <p class="text-sm text-zinc-700">
            No scheduled wake source is recorded for this goal. A sleeping goal wakes
            only through a durable wake intent — an Oban wakeup-queue delivery for a
            cobbler_wakeups row, scheduled from an admission deferral or an operator
            recheck below. No wake time is invented here.
          </p>
        <% end %>
        <%= if @pending_wakeup do %>
          <p id="cobbler-pending-wake" class="text-sm text-zinc-700">
            Next wake intent:
            <time datetime={DateTime.to_iso8601(@pending_wakeup.wake_at)}>
              {DateTime.to_iso8601(@pending_wakeup.wake_at)}
            </time>
            <span class="text-zinc-500">
              ({@pending_wakeup.reason}, {@pending_wakeup.status})
            </span>
          </p>
        <% end %>
        <.form
          for={@recheck_form}
          id="cobbler-recheck-form"
          phx-submit="request_recheck"
          class="space-y-3 rounded-md border border-sky-200 bg-sky-50 p-4"
        >
          <.input
            field={@recheck_form[:operator_identity]}
            id="cobbler-recheck-operator"
            type="text"
            label="Operator identity (required for manual wake/recheck)"
            autocomplete="off"
          />
          <button
            type="submit"
            id="cobbler-recheck-submit"
            class="rounded-md bg-sky-700 px-3 py-1.5 text-xs font-semibold text-white hover:bg-sky-800"
          >
            Request wake recheck
          </button>
        </.form>
      </div>

      <%!-- Commands + confirm/respond forms --%>
      <div class="rounded-lg border border-zinc-200 bg-white p-6 shadow-sm space-y-4">
        <h3 class="text-sm font-semibold uppercase tracking-wider text-zinc-800 flex items-center gap-1.5">
          <.icon name="hero-command-line" class="w-4 h-4 text-zinc-500" /> Commands
        </h3>
        <div id="cobbler-commands-list" phx-update="stream" class="space-y-3">
          <div
            :if={@commands_empty?}
            id="cobbler-commands-empty"
            class="hidden only:block rounded-lg border border-dashed border-zinc-300 p-4 text-sm text-zinc-500"
          >
            No commands recorded for this goal.
          </div>

          <div
            :for={{dom_id, cmd} <- @streams.commands}
            id={dom_id}
            data-status={command_status_tag(cmd.status)}
            class="rounded-md border border-zinc-200 p-4 space-y-2"
          >
            <div class="flex flex-wrap items-center justify-between gap-2 text-sm">
              <span class="font-mono font-semibold text-zinc-900">{cmd.command_id}</span>
              <span class="text-zinc-500">{cmd.type} · {cmd.status}</span>
            </div>
            <pre class="rounded bg-zinc-50 p-2.5 text-[11px] font-mono text-zinc-700 overflow-auto whitespace-pre-wrap border border-zinc-100 max-h-48">{command_result_summary(cmd)}</pre>
            <%= if cmd.status == "needs_user" do %>
              <% options = offered_options(cmd) %>
              <%= if options == [] do %>
                <p class="text-xs text-zinc-500 italic">
                  This command awaits an operator decision with no offered response yet.
                </p>
              <% else %>
                <.form
                  :if={form = Map.get(@respond_forms, cmd.command_id)}
                  for={form}
                  id={"cobbler-confirm-form-#{cmd.id}"}
                  phx-change="validate"
                  phx-submit="respond"
                  class="space-y-3 rounded-md border border-purple-200 bg-purple-50 p-4"
                >
                  <.input field={form[:command_id]} type="hidden" />
                  <.input
                    field={form[:resolution]}
                    id={"cobbler-resolution-#{cmd.id}"}
                    type="select"
                    label="Operator response"
                    options={options}
                  />
                  <.input
                    field={form[:confirmed_by]}
                    id={"cobbler-confirmed-by-#{cmd.id}"}
                    type="text"
                    label="Confirmed by (operator identity, required)"
                    autocomplete="off"
                  />
                  <.input
                    field={form[:intent]}
                    id={"cobbler-intent-#{cmd.id}"}
                    type="text"
                    label={"Type the command intent to confirm: #{intent_of(cmd)}"}
                    autocomplete="off"
                  />
                  <button
                    type="submit"
                    id={"cobbler-confirm-submit-#{cmd.id}"}
                    class="rounded-md bg-purple-700 px-3 py-1.5 text-xs font-semibold text-white hover:bg-purple-800"
                  >
                    Record operator response
                  </button>
                </.form>
              <% end %>
            <% end %>
          </div>
        </div>
      </div>

      <%!-- Projection status --%>
      <div
        id="cobbler-projection-status"
        data-status={@projection.status}
        class="rounded-lg border border-zinc-200 bg-white px-4 py-3"
      >
        <span class="font-medium text-sm">Projection: {@projection.status}</span>
        <%= if @projection.error_detail do %>
          <p id="cobbler-projection-error" class="mt-2 text-sm text-red-700">
            {@projection.error_detail}
          </p>
        <% end %>
        <%= if @projection.status == "failed" do %>
          <button
            phx-click="rebuild"
            id="cobbler-rebuild"
            class="mt-3 rounded-md bg-zinc-900 px-3 py-1.5 text-xs font-semibold text-white hover:bg-zinc-700"
          >
            Re-check command rebuild (read-only)
          </button>
        <% end %>
      </div>

      <%!-- Events stream --%>
      <div class="rounded-lg border border-zinc-200 bg-white p-6 shadow-sm space-y-4">
        <h3 class="text-sm font-semibold uppercase tracking-wider text-zinc-800 flex items-center gap-1.5">
          <.icon name="hero-queue-list" class="w-4 h-4 text-zinc-500" /> Trajectory Events
        </h3>
        <div id="cobbler-events-list" phx-update="stream" class="space-y-3">
          <div
            id="cobbler-events-empty"
            class="hidden only:block rounded-lg border border-dashed border-zinc-300 p-4 text-sm text-zinc-500"
          >
            No events recorded for this goal.
          </div>

          <div
            :for={{dom_id, event} <- @streams.events}
            id={dom_id}
            data-sequence={event.sequence}
            class="rounded-md border border-zinc-200 p-4 space-y-2"
          >
            <div class="flex flex-wrap items-center gap-2 text-xs">
              <span class="font-bold text-zinc-900 bg-zinc-100 px-1.5 py-0.5 rounded font-mono">
                #{event.sequence}
              </span>
              <span class="font-semibold text-zinc-800 font-mono">{event.type}</span>
              <span class="text-zinc-500">by {event.actor}</span>
              <time class="text-zinc-400 font-mono">{event_time(event)}</time>
            </div>
            <pre class="rounded bg-zinc-50 p-2.5 text-[11px] font-mono text-zinc-700 overflow-auto whitespace-pre-wrap border border-zinc-100 max-h-48">{event_payload_text(event)}</pre>
          </div>
        </div>
      </div>
    </div>
  <% end %>
</Layouts.app>
