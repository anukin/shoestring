    "pantry.py": "def greeting(name):\n    return \"Hello, \" + name + \"!\"\n\n\ndef total_cents(items):\n    return len(items)\n\n\ndef receipt(items):\n    return f\"Items: {len(items)}\"\n\n\ndef catalog(names):\n    return names\n",
    "test/__init__.py": "\"\"\"Standard-library acceptance tests for the Pantry evaluation fixture.\"\"\"\n",
    "test/test_catalog.py": "import unittest\n\nfrom pantry import catalog\n\n\nclass CatalogTest(unittest.TestCase):\n    def test_trim_remove_blanks_deduplicate_and_sort(self):\n        self.assertEqual(\n            catalog([\" pear \", \"Apple\", \"\", \"pear\", \"  \", \"apple\"]),\n            [\"Apple\", \"apple\", \"pear\"],\n        )\n        self.assertEqual(catalog([]), [])\n\n\nif __name__ == \"__main__\":\n    unittest.main()\n",
    "test/test_greeting.py": "import unittest\n\nfrom pantry import greeting\n\n\nclass GreetingTest(unittest.TestCase):\n    def test_trim_names_and_substitute_blanks(self):\n        self.assertEqual(greeting(\"  Sam  \"), \"Hello, Sam!\")\n        self.assertEqual(greeting(\"   \"), \"Hello, friend!\")\n        self.assertEqual(greeting(\"Jo\"), \"Hello, Jo!\")\n\n\nif __name__ == \"__main__\":\n    unittest.main()\n",
    "test/test_receipt.py": "import unittest\n\nfrom pantry import receipt\n\n\nclass ReceiptTest(unittest.TestCase):\n    def test_render_using_basket_total(self):\n        self.assertEqual(receipt([]), \"Total: 0 cents\")\n        self.assertEqual(\n            receipt([\n                {\"price_cents\": 125, \"quantity\": 2},\n                {\"price_cents\": 75, \"quantity\": 3},\n            ]),\n            \"Total: 475 cents\",\n        )\n\n\nif __name__ == \"__main__\":\n    unittest.main()\n",
    "test/test_total.py": "import unittest\n\nfrom pantry import total_cents\n\n\nclass TotalTest(unittest.TestCase):\n    def test_sum_integer_prices_with_quantities(self):\n        self.assertEqual(total_cents([]), 0)\n        self.assertEqual(\n            total_cents([\n                {\"price_cents\": 125, \"quantity\": 2},\n                {\"price_cents\": 75, \"quantity\": 3},\n            ]),\n            475,\n        )\n\n\nif __name__ == \"__main__\":\n    unittest.main()\n"
