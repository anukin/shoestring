ls in integer cents\"},{\"acceptance_criteria\":[\"Preserve the public receipt(items) signature.\",\"Use total_cents(items) as the receipt amount.\",\"Render the exact string Total: N cents, including Total: 0 cents for an empty basket.\"],\"checkpoint\":{\"condition\":\"Receipt output reflects the calculated basket total and both named acceptance tests pass.\",\"evidence\":[\"test/test_receipt.py passes for empty and multi-item baskets.\",\"test/test_total.py passes for empty and multi-item baskets.\"]},\"depends_on\":[\"implement-total\"],\"execution\":{\"max_attempts\":1,\"max_duration_seconds\":300},\"expected_artifacts\":[\"Updated receipt implementation in pantry.py.\"],\"gates\":[{\"gate\":\"python_unittest\",\"test_paths\":[\"test/test_receipt.py\",\"test/test_total.py\"]}],\"hints\":{\"files\":[\"pantry.py\",\"test/test_receipt.py\"],\"symbols\":[\"receipt\",\"total_cents\"]},\"id\":\"render-receipt\",\"inputs\":[\"pantry.py currently renders the item count.\",\"test/test_receipt.py specifies exact output for empty and multi-item baskets.\"],\"outcome\":\"receipt(items) renders the computed total in the exact format Total: N cents, including for an empty basket.\",\"risks\":[\"Receipt formatting must match the specified output exactly.\"],\"title\":\"Render receipt using the basket total\"}],\"version\":1}",
