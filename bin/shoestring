#!/bin/sh
# Shoestring from any directory, using this checkout: the same commands,
# arguments, output and exit status as the installed `shoestring`
# (Shoestring.CLI.Main), against the checkout's state. The caller's directory
# is the repository for `do` and the base for relative paths.
set -eu

# Resolve this script through symlinks to find the checkout.
script=$0
while [ -L "$script" ]; do
  link=$(readlink "$script")
  case $link in
    /*) script=$link ;;
    *) script=$(dirname "$script")/$link ;;
  esac
done
checkout=$(cd "$(dirname "$script")/.." && pwd)

SHOESTRING_CALLER_DIR=$PWD
export SHOESTRING_CALLER_DIR
cd "$checkout"
exec mix shoestring "$@"
