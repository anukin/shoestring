#!/bin/sh
# Shoestring from any directory, using this checkout: the same commands,
# arguments, output and exit status as the installed `shoestring`
# (Shoestring.CLI.Main), against the checkout's state. The caller's directory
# is the repository for `do` and the base for relative paths.
set -eu

# Resolve this script through symlinks to find the checkout.
script=$0
while [ -L "$script" ]; do
  link=$(readlink "$script")
  case $link in
    /*) script=$link ;;
    *) script=$(dirname "$script")/$link ;;
  esac
done
checkout=$(cd "$(dirname "$script")/.." && pwd)

SHOESTRING_CALLER_DIR=$PWD
export SHOESTRING_CALLER_DIR
cd "$checkout"

# `chat` prepares the session in Mix, then starts the coordinator's terminal
# interface here, so it owns the terminal: Mix writes a launch script and
# this shell execs it.
if [ "${1:-}" = "chat" ]; then
  launch=$(mktemp "${TMPDIR:-/tmp}/shoestring-chat.XXXXXX")
  status=0
  mix shoestring "$@" --launch-file "$launch" || status=$?
  if [ "$status" -ne 0 ]; then rm -f "$launch"; exit "$status"; fi
  if [ -s "$launch" ]; then exec sh "$launch"; fi
  rm -f "$launch"
  exit 0
fi

exec mix shoestring "$@"
