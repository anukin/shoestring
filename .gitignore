# The directory Mix will write compiled artifacts to.
/_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# Where 3rd-party dependencies like ExDoc output generated docs.
/doc/

# Ignore .fetch files in case you like to edit your project deps locally.
/.fetch

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Temporary files, for example, from tests.
/tmp/

# Ignore package tarball (built via "mix hex.build").
shoestring-*.tar

# Database files
*.db
*.db-*
*.sqlite
*.sqlite3

# Shoestring's local state and release/runtime output.
/.shoestring/
/.state/
/release/
/priv/releases/
/priv/static/uploads/
/priv/static/cache_manifest.json
/priv/static/**/*.gz
/priv/static/**/*-*.*

# Planning documents are intentionally local to this workspace.
/plans/*
!/plans/milestones/
plans/milestones/*
!/plans/milestones/00a-capacity-feasibility.md
!/plans/evidence/
plans/evidence/*
!/plans/evidence/00a-capacity-feasibility/
!/plans/evidence/00a-capacity-feasibility/**

# Editor, language-server, and OS metadata
/.elixir_ls/
.DS_Store

# Local environment files and generated secrets (do not ignore source config).
.env
.env.*
!.env.example
/config/*.secret.exs

# Codex runtime scratch (may contain local authentication state).
/.codex-tmp/
